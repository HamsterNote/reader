+// Reader patch: full suppression must also cover WKContentView's edit menu.
+static BOOL RNCShouldSuppressSystemEditMenu(NSArray *menuItems, NSArray *suppressedItems)
+{
+  if (menuItems != nil) {
+    return menuItems.count == 0;
+  }
+  NSSet *systemItems = [NSSet setWithArray:@[
+    @"copy", @"lookup", @"translate", @"share", @"cut", @"paste", @"replace",
+    @"select", @"selectAll", @"bold", @"italic", @"underline"
+  ]];
+  return [systemItems isSubsetOfSet:[NSSet setWithArray:suppressedItems ?: @[]]];
+}
+#endif
