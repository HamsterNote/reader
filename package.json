{
  "name": "@hamster-note/reader",
  "version": "3.0.1",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamsterNote/reader.git"
  },
  "homepage": "https://github.com/HamsterNote/reader#readme",
  "bugs": {
    "url": "https://github.com/HamsterNote/reader/issues"
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "yarn build:lib:js && yarn build:lib:types && yarn build:lib:styles",
    "build:lib:js": "vite build --config vite.lib.config.ts",
    "build:lib:types": "tsc --project tsconfig.build.json",
    "build:lib:styles": "node scripts/build-styles.mjs",
    "build:demo": "vite build",
    "build:all": "yarn build:lib && yarn build:demo",
    "build": "yarn build:all",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "prepublishOnly": "yarn build:lib",
    "pack:check": "node scripts/check-pack.mjs",
    "build:webview": "node scripts/build-webview.mjs",
    "verify:webview": "node scripts/verify-webview-assets.mjs",
    "check:browser": "node scripts/check-reader-browser.mjs",
    "check:web-selection": "node scripts/check-web-selection.mjs",
    "host:start": "cd app && npx expo start --dev-client",
    "host:android": "yarn build:webview && cd app && npx expo run:android",
    "prepare:ios": "node scripts/apply-ios-webview-patch.mjs",
    "host:ios": "yarn build:webview && yarn prepare:ios && cd app && npx expo run:ios",
    "host:ios:offline": "yarn build:webview && yarn prepare:ios && cd app && npx expo run:ios --configuration Release --no-bundler",
    "host:prebuild": "yarn prepare:ios && cd app && npx expo prebuild",
    "typecheck:host": "tsc --project app/tsconfig.json --noEmit",
    "host:check": "yarn build:webview && yarn verify:webview && yarn typecheck:host",
    "check:painting": "node scripts/check-painting-browser.mjs",
    "check:workspace": "node scripts/check-workspace-browser.mjs",
    "check:session-replacement": "node scripts/check-session-replacement-browser.mjs",
    "check:pdf-text-readiness": "node scripts/check-session-replacement-browser.mjs --text",
    "check:flow-text-readiness": "node scripts/check-flow-text-readiness.mjs",
    "check:pagination-input": "node scripts/check-pagination-input-browser.mjs",
    "check:native-epub-anchor": "node scripts/check-native-epub-anchor.mjs",
    "check:native-epub-highlights": "node scripts/check-native-epub-highlights.mjs",
    "check:pdf-inset": "node scripts/check-pdf-page-inset.mjs"
  },
  "dependencies": {
    "@hamster-note/components": "0.2.1-beta.3",
    "@hamster-note/docx-parser": "^0.1.0",
    "@hamster-note/epub-parser": "0.3.0-beta.2",
    "@hamster-note/image-parser": "^0.3.0",
    "@hamster-note/markdown-parser": "0.1.2-beta.2",
    "@hamster-note/pdf-parser": "^1.1.0",
    "@hamster-note/txt-parser": "^0.3.0",
    "@hamster-note/types": "^0.8.0",
    "@hamster-note/virtual-paper": "1.1.0",
    "@system-ui-js/multi-drag": "^0.4.0",
    "@tanstack/react-virtual": "^3.14.5",
    "html2canvas": "^1.4.1",
    "pdfjs-dist": "5.4.530",
    "use-undo": "^1.2.0"
  },
  "peerDependencies": {
    "@hamster-note/selection": "0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@hamster-note/painting": "^0.8.4 || ^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@hamster-note/selection": "0.3.0",
    "@system-ui-js/development-base": "^0.1.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.0.0",
    "base64-js": "1.5.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "expo": "57.0.32",
    "expo-asset": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fflate": "0.8.2",
    "globals": "^15.14.0",
    "jsdom": "^27.0.0",
    "jszip": "^3.10.1",
    "playwright": "1.60.0",
    "prettier": "^3.7.4",
    "prettier-config-standard": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1",
    "sass": "^1.0.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "@hamster-note/painting": "0.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
