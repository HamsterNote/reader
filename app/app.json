{
  "expo": {
    "name": "Hamster Reader",
    "slug": "hamster-reader",
    "version": "0.1.0",
    "scheme": "hamsterreader",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hamsternote.reader",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.hamsternote.reader",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": ["expo-document-picker", "./plugins/with-ios-scene.cjs"],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "e90ee40c-54b7-42b8-895f-97f026713062"
      }
    },
    "owner": "wszxdhr"
  }
}
