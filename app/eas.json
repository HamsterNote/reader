{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "extends": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "24.15.0",
      "yarn": "1.22.22",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  }
}
