{
  "name": "hamster-reader-host",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "node ../scripts/apply-ios-webview-patch.mjs && expo run:ios",
    "prebuild": "node ../scripts/apply-ios-webview-patch.mjs && expo prebuild"
  },
  "dependencies": {
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "expo-system-ui": "~57.0.4"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
